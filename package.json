{
  "repository": {
    "type": "git",
    "url": "https://github.com/sserhii-tech/home-assistant-mcp.git"
  },
  "name": "ha-ai",
  "version": "0.4.0",
  "type": "module",
  "description": "Lightweight, paranoid-secure Home Assistant AI MCP Server and Addon",
  "workspaces": [
    "mcp-server"
  ],
  "scripts": {
    "build": "npm run --prefix mcp-server build",
    "test": "npm run --prefix mcp-server test",
    "lint": "npm run --prefix mcp-server lint",
    "test:mcp": "npm run --prefix mcp-server test",
    "test:addon": "uv run --directory ha-mcp-helper --extra dev pytest tests",
    "dev:addon": "uv run --directory ha-mcp-helper uvicorn app.main:app --host 0.0.0.0 --port 8099 --reload",
    "dev:mcp": "npm run --prefix mcp-server build -- --watch",
    "publish:mcp": "npm run build && npm publish --workspace=mcp-server --access public",
    "version:bump": "node scripts/bump-version.js"
  },
  "keywords": [
    "home-assistant",
    "homeassistant",
    "home-assistant-addon",
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "claude-desktop",
    "antigravity",
    "lovelace",
    "dashboard-design",
    "automation",
    "visual-feedback",
    "playwright"
  ],
  "homepage": "https://github.com/sserhii-tech/home-assistant-mcp#readme",
  "bugs": {
    "url": "https://github.com/sserhii-tech/home-assistant-mcp/issues"
  },
  "author": "",
  "license": "Apache-2.0",
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
